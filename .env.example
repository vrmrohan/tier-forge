# Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgres://tierforge:tierforge@localhost:5432/tierforge
REDIS_URL=redis://localhost:6379
SIMULATOR_URL=http://localhost:8000

# API
PORT=3000
LOG_LEVEL=info

# Enrichment engine tuning (defaults shown)
RUN_WORKERS=true
WORKER_CONCURRENCY=8
RATE_LIMIT_PER_SECOND=4
REQUEST_TIMEOUT_MS=10000
LEASE_MS=30000
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=30000
WORKER_IDLE_POLL_MS=500
RATE_LIMIT_PAUSE_MS=1000
BREAKER_WINDOW_MS=30000
BREAKER_MIN_FAILURES=10
REAPER_INTERVAL_MS=5000
